[Unit]
Description=Mail Bridge Rust HTTP MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=mail-bridge-rust
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mail-bridge-rust
ExecStart=/opt/mail-bridge-rust/mail-bridge-rust
EnvironmentFile=/etc/mail-bridge-rust/service.env
EnvironmentFile=-/etc/mail-bridge-rust/safety.env
LoadCredential=owner_password:/etc/mail-bridge-rust/owner_password
Environment=MAIL_BRIDGE_OWNER_PASSWORD_FILE=%d/owner_password
Environment=MAIL_BRIDGE_DATA_DIR=/var/lib/mail-bridge-rust
Environment=MAIL_BRIDGE_BIND=127.0.0.1:18765
UMask=0077
Restart=on-failure
RestartSec=5
MemoryHigh=128M
MemoryMax=160M
TasksMax=16
LimitNOFILE=64
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
